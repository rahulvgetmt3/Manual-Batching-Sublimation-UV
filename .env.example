# Copy to .env and fill in. Never commit the real .env.

# Pulse (mt3narada) - use a READ-ONLY database user
DB_HOST=pulse.getmt3.com
DB_PORT=3306
DB_NAME=mt3narada
DB_USER=
DB_PASSWORD=

# Portal logins: comma-separated username:password pairs
PORTAL_USERS=operator1:change-me,operator2:change-me

# Long random string; signs login cookies. e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(48))"`
# (On a Windows test PC this can stay empty - Start UV Mix.bat makes one each time.)
SECRET_KEY=

# 1 when served over HTTPS (production), 0 for local http. Start UV Mix.bat always uses 0.
COOKIE_SECURE=1

# ---- Optional (defaults shown; all under this folder's data/) ----
# Where generated runs, downloaded print files and uploaded Sublimation templates are kept
# RUNS_DIR=data/runs
# CACHE_DIR=data/cache
# TEMPLATES_DIR=data/templates/sublimation
# Spot ink name in the UV Spot PDF (must match the RIP / the team's Photoshop channel)
# SPOT_NAME=Spot Color 1
